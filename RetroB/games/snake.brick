GAME_TYPE SNAKE
GAME_GRID (18, 18)

# Cada cuantas frutas seguidas se otorga el bono de racha (x1.5 puntos)
STREAK_TARGET: 5

# Multiplicador de velocidad base (1.0 = normal, <1.0 = mas rapido, >1.0 = mas lento)
TICK_MULTIPLIER: 1.0


# -------------------------------------------------------------
# TIPOS DE FRUTA (S03-S06)
# -------------------------------------------------------------

DEFINE FRUIT MANZANA:
    COLOR: #FF3860
    SCORE: 1
    PATTERN: SOLID
    EFFECT: NONE
END

DEFINE FRUIT DORADA:
    COLOR: #F9F002
    SCORE: 5
    PATTERN: STRIPES
    EFFECT: DOUBLE_POINTS
END

DEFINE FRUIT ARANDANO:
    COLOR: #00FFF2
    SCORE: 3
    PATTERN: DOTS
    EFFECT: SPEED_BOOST
END


# -------------------------------------------------------------
# COLORES DE LA SERPIENTE SEGUN ETAPA (S01)
# Pequena = verde, mediana = roja, grande = arcoiris animado
# -------------------------------------------------------------

DEFINE STAGE_COLORS:
    STAGE(0,5): #39FF14
    STAGE(6,12): #FF3860
    STAGE(13,999): RAINBOW
END


# -------------------------------------------------------------
# EVENTOS
# -------------------------------------------------------------

ON START:
    SPAWN PLAYER AT (9,9)
    SPAWN FOOD AT RANDOM
END

ON TICK:
    MOVE PLAYER FORWARD
END

ON EAT_FOOD:
    SPAWN FOOD AT RANDOM
    PLAY_SOUND "eat.wav"
END

ON COLLISION_WALL:
    PLAY_SOUND "gameover.wav"
    GAME_OVER
END

ON COLLISION_SELF:
    PLAY_SOUND "gameover.wav"
    GAME_OVER
END

ON KEY_UP:
    SET_DIRECTION UP
END

ON KEY_DOWN:
    SET_DIRECTION DOWN
END

ON KEY_LEFT:
    SET_DIRECTION LEFT
END

ON KEY_RIGHT:
    SET_DIRECTION RIGHT
END
